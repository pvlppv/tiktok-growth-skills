# App Store Connect API key (Users and Access -> Integrations -> Team Keys).
# Sales reports need the Sales/Finance or Admin role; analytics reports need Admin.
ASC_KEY_ID=YOUR_KEY_ID
ASC_ISSUER_ID=YOUR_ISSUER_UUID
ASC_P8=~/.config/appstore/AuthKey_YOUR_KEY_ID.p8
# Payments and Financial Reports -> top left, the number under your name
ASC_VENDOR_NUMBER=YOUR_VENDOR_NUMBER

# Optional: only when one vendor account holds several apps
# ASC_APP_ID=1234567890        # App Apple ID, filters subscription events + impressions
# ASC_APP_SKU=your-app-sku     # filters sales rows (app SKU, also the Parent Identifier of its IAPs)
# Optional: an ONGOING analytics report request id, for daily impressions on the dashboard
# ASC_ANALYTICS_REQUEST_ID=YOUR_REQUEST_ID
# Optional: if Apple answers 400 on the subscription event report, try 1_3
# ASC_EVENT_VERSION=1_4

# Where caches, snapshots, posts.csv and dashboard.md live (default ./growth-data)
# GROWTH_DATA=./growth-data
# One TikTok handle per line, optional label words, optional id:<tiktok user id>
# ACCOUNTS_FILE=./accounts.txt
# Caption files you posted, ';'-separated, each 'format=glob' or a bare glob
# POSTS_CAPTIONS=tips=renders/tips/*/caption.txt;stories=renders/stories/*/caption.txt

# Optional Notion sync (dashboard.py --notion): an internal integration + the page it may edit
# NOTION_TOKEN=YOUR_INTEGRATION_SECRET
# NOTION_PAGE_ID=YOUR_PAGE_ID
