# copy to .env (next to SKILL.md or in the folder you run from). Never commit .env.
# A real environment variable wins over this file; an empty value here is ignored.

# Telegram (review + hand-posting albums)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional: a separate chat for review albums (default: TELEGRAM_CHAT_ID)
TELEGRAM_REVIEW_CHAT_ID=
# optional: forum topic id inside the chat
TELEGRAM_TOPIC_ID=

# Postiz Cloud (postiz route)
POSTIZ_API_KEY=
# optional, self-hosted instance: https://your-domain/api/public/v1
POSTIZ_API_URL=

# iPhone farm (farm route)
FARM_URL=http://127.0.0.1:3100
FARM_PLUGIN=
